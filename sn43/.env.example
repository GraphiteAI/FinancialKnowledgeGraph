# ──────────────────────────────────────────────────────────────
# Shared Bittensor configuration (validators AND miners need these)
# ──────────────────────────────────────────────────────────────

# Bittensor wallet:
BT_WALLET_COLD=your_coldkey_name
BT_WALLET_HOT=your_hotkey_name

SUBTENSOR_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
BT_NETWORK=finney

# Subnet ID
NETUID=43

# SEC EDGAR User-Agent (required on every EDGAR request — both sides
# fetch SEC bytes, validators for verification + miners for extraction).
SN43_EDGAR_CONTACT=your_email@example.com

# Logging
LOG_LEVEL=INFO


# ──────────────────────────────────────────────────────────────
# Validator-only configuration
# ──────────────────────────────────────────────────────────────

# Public IP that miners use to reach this validator. The axon record
# published to chain at startup uses this IP. If unset, bittensor will
# attempt auto-detection (works on most cloud VMs but fails behind NAT).
EXTERNAL_IP=

# Where the validator's event bus listens — miners connect here.
#   /events (WebSocket) + /submit (HTTP POST)
EVENT_BUS_HOST=0.0.0.0
EVENT_BUS_PORT=8765

# Graph Data Server
CENTRAL_SERVER_URL=https://api.graphite-ai.net

# Where the bus persists its dedupe cache (tasks with at least one
# miner response). Survives restarts so old filings aren't re-broadcast.
DEDUPE_CACHE_PATH=data/dedupe_cache.json


# ──────────────────────────────────────────────────────────────
# Miner-only configuration
# ──────────────────────────────────────────────────────────────

# Your Bittensor miner UID (assigned after registration on subnet 43).
MINER_UID=42

# LLM keys (OPTIONAL — miners choose their own extraction stack).
# Validators do NOT use LLMs (scoring is deterministic by design).
# Reminder: LLM calls are fine for extraction output, but NEVER inside
# the causal-inference code that gets re-run in the validator sandbox —
# that code must be deterministic (numpy/statsmodels/pandas, fixed seed).
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# Where to store fetched source documents (content-addressed by sha256).
DOC_STORE_ROOT=./data/doc_store

# If `true`, miner ships source bytes inline for non-whitelisted URLs
# (paywalled sources). Stored on validators as `paywalled_content`
# evidence. Default off (saves bandwidth; non-whitelisted items just
# become `url_only` claims).
SUBMIT_PAYWALLED_CONTENT=false
